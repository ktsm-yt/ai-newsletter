# テンプレート: `cp env.example .env` してから値を埋めてください
# (.env は .gitignore で track 対象外)

# Slack (A.1 で取得)
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_CHANNEL_ID=C0123ABCD45

# Gemini (C.2 で取得 / https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# GitHub API (B.2 着手時 / fine-grained token、scope: public_repo 読み取り)
GH_TOKEN=

# Reddit OAuth (B.3 着手時 / https://www.reddit.com/prefs/apps の script app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ai-newsletter/0.1 by <your-reddit-username>
